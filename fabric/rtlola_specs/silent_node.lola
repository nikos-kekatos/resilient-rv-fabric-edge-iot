// P3.5 -- silent node.
//
// "A device that was reporting has produced no verdict for T_dev seconds, while
//  monitoring time keeps advancing."
//
// Two things the earlier version got wrong, both of which inverted the property:
//   * it spawned an instance only `with overflow`, so a device was watched only
//     after it had already attacked -- a device that simply went quiet was never
//     instantiated, which is exactly the case P3.5 exists to catch;
//   * it counted `safe_tx` alone, so a device streaming overflows (the opposite of
//     silent) satisfied the trigger.
//
// A node is now spawned by ANY verdict it emits, and is silent when it has emitted
// NOTHING -- benign or malicious -- for the whole window. The @Local clock is what
// makes this decidable under total fleet silence: it advances with no input, which
// is the tick (G3) the fabric supplies.

input safe_tx: String
input overflow: String
input time_anomaly: String
input fuzzing: String

// T_dev = 5s, the deployed silence window (the value backend_l3.py runs and the
// one the paper quotes). RTLola requires a literal duration in aggregate(over:),
// so it appears inline below rather than as a constant. T_dev must exceed the
// fleet's benign reporting interval, or healthy devices are flagged between
// reports. NOTE: exp_oracle.py's SILENCE_NODE_T = 8 is a different parameter --
// the threshold for its seeded synthetic workload, not the deployed one.

// Any verdict from a node counts as "still reporting".
output reported(node: String)
  spawn with safe_tx
  eval @safe_tx        when safe_tx      == node with true
  eval @overflow       when overflow     == node with true
  eval @time_anomaly   when time_anomaly == node with true
  eval @fuzzing        when fuzzing      == node with true

trigger(node: String)
  spawn with safe_tx
  eval @Local(1Hz)
    when reported(node).aggregate(over: 5s, using: count) == 0
    with "silent_node_anomaly"   // the silent node is the trigger instance, printed as #0(<node>)
